# Flat KEY=value format; no expansion, commands, or inline comments.
# Run: python3 tools/manage.py init (creates .env with random secrets).
COMPOSE_PROJECT_NAME=mobile-starter
GAME_TITLE=Mobile Starter
BUNDLE_ID=com.example.mobilestarter
NAKAMA_IMAGE=registry.heroiclabs.com/heroiclabs/nakama:3.41.0
POSTGRES_IMAGE=postgres:17.6-alpine
CADDY_IMAGE=caddy:2.10.2-alpine
POSTGRES_PASSWORD=change_me
NAKAMA_SERVER_KEY=change_me
NAKAMA_SESSION_KEY=change_me
NAKAMA_REFRESH_KEY=change_me
NAKAMA_RUNTIME_KEY=change_me
NAKAMA_CONSOLE_PASSWORD=change_me
NAKAMA_CONSOLE_SIGNING_KEY=change_me
LOG_LEVEL=INFO
# Public client configuration; server key is a public API identifier, not a secret.
CLIENT_API_URL=http://127.0.0.1:7350
# For a physical Android device, bind to 0.0.0.0 and use the computer's LAN IP above.
# Production deployment requires 127.0.0.1; Caddy is the public entry point.
LOCAL_BIND_IP=127.0.0.1
LOCAL_API_PORT=7350
LOCAL_CONSOLE_PORT=7351
# Godot executable or command. This default works if godot is on PATH.
GODOT_BIN=godot
# Production: DNS A/AAAA must point here; ports 80/443 must be available.
API_DOMAIN=api.example.com
TLS_EMAIL=you@example.com
SSH_HOST=your-vps
SSH_USER=deploy
SSH_PORT=22
DEPLOY_PATH=/opt/mobile-starter
