# Flat KEY=value format; no expansion, commands, or inline comments.
# Run: node tools/manage.mjs init (creates .env with random secrets).
# Set a unique game identity before the first up; init keeps these example values.
COMPOSE_PROJECT_NAME=mobile-starter
GAME_TITLE=Mobile Starter
BUNDLE_ID=com.example.mobilestarter
NAKAMA_IMAGE=registry.heroiclabs.com/heroiclabs/nakama:3.41.0
POSTGRES_IMAGE=postgres:17.6-alpine
CADDY_IMAGE=caddy:2.10.2-alpine
POSTGRES_PASSWORD=change_me
NAKAMA_SERVER_KEY=change_me
NAKAMA_SESSION_KEY=change_me
NAKAMA_REFRESH_KEY=change_me
NAKAMA_RUNTIME_KEY=change_me
NAKAMA_CONSOLE_PASSWORD=change_me
NAKAMA_CONSOLE_SIGNING_KEY=change_me
LOG_LEVEL=INFO
# Public client configuration; server key is a public API identifier, not a secret.
CLIENT_API_URL=http://127.0.0.1:7350
# For a physical Android device, bind to 0.0.0.0 and use the computer's LAN IP above.
# Production deployment requires 127.0.0.1; Caddy is the public entry point.
LOCAL_BIND_IP=127.0.0.1
# Use available ports when running multiple games; match CLIENT_API_URL to LOCAL_API_PORT.
LOCAL_API_PORT=7350
LOCAL_CONSOLE_PORT=7351
# Godot executable or command. This default works if godot is on PATH.
GODOT_BIN=godot
# Production: DNS A/AAAA must point here; ports 80/443 must be available.
API_DOMAIN=api.example.com
TLS_EMAIL=you@example.com
SSH_HOST=your-vps
SSH_USER=deploy
SSH_PORT=22
DEPLOY_PATH=/opt/mobile-starter

# Optional mobile export inputs. Blank assets keep setup usable before art exists.
# Run configure after editing; generated presets contain public metadata only.
APP_VERSION=0.1.0
APP_BUILD_NUMBER=1
APP_ICON=
BOOT_SPLASH_IMAGE=
ANDROID_ICON=
ANDROID_ADAPTIVE_FOREGROUND=
ANDROID_ADAPTIVE_BACKGROUND=
ANDROID_ADAPTIVE_MONOCHROME=
IOS_TEAM_ID=
IOS_ICON=
IOS_LAUNCH_IMAGE_2X=
IOS_LAUNCH_IMAGE_3X=
# Native SDK/JDK paths are machine-local Godot Editor Settings, not game resources.
# Android signing: absolute local paths; passwords NEVER enter export_presets.cfg.
GODOT_ANDROID_KEYSTORE_DEBUG_PATH=
GODOT_ANDROID_KEYSTORE_DEBUG_USER=
GODOT_ANDROID_KEYSTORE_DEBUG_PASSWORD=
GODOT_ANDROID_KEYSTORE_RELEASE_PATH=
GODOT_ANDROID_KEYSTORE_RELEASE_USER=
GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=
