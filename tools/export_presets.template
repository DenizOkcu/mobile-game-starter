[preset.0]
name="Android"
platform="Android"
runnable=true
dedicated_server=false
export_filter="all_resources"
export_files=PackedStringArray("res://client/config.json")
include_filter="LICENSE,client/config.json,addons/com.heroiclabs.nakama/LICENSE"
exclude_filter="framework*.json,framework-update-report.md,CHANGELOG.md,.env*,server/*,infra/*,tools/*,tests/*,docs/*,openspec/*,backups/*,.agents/*,.claude/*,.cursor/*,.setup/*"
export_path="exports/android/prototype.apk"

[preset.0.options]
package/unique_name="@BUNDLE_ID@"
package/signed=true
permissions/internet=true
screen/immersive_mode=true
architectures/arm64-v8a=true
architectures/armeabi-v7a=false
@ANDROID_OPTIONS@

[preset.1]
name="iOS"
platform="iOS"
runnable=true
dedicated_server=false
export_filter="all_resources"
export_files=PackedStringArray("res://client/config.json")
include_filter="LICENSE,client/config.json,addons/com.heroiclabs.nakama/LICENSE"
exclude_filter="framework*.json,framework-update-report.md,CHANGELOG.md,.env*,server/*,infra/*,tools/*,tests/*,docs/*,openspec/*,backups/*,.agents/*,.claude/*,.cursor/*,.setup/*"
export_path="exports/ios/prototype.zip"

[preset.1.options]
application/bundle_identifier="@BUNDLE_ID@"
application/export_project_only=true
@IOS_OPTIONS@
