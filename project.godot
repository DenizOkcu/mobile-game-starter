config_version=5

[application]
config/name="Mobile Starter"
run/main_scene="res://client/ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
AppConfig="*res://client/core/config.gd"
Preferences="*res://client/core/preferences.gd"
Backend="*res://client/core/backend.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)

[input_devices]
pointing/emulate_touch_from_mouse=true
